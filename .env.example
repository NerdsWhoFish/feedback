ENVIRONMENT=local
HTTP_ADDR=127.0.0.1:8080
METRICS_ADDR=
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://feedback:feedback-local@127.0.0.1:55432/feedback?sslmode=disable
ADMIN_EMAILS=owner@example.com
OIDC_ISSUER=https://auth.theoutdoorprogrammer.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
SESSION_TTL=12h
KEY_RATE_LIMIT_RPM=120
WEBHOOK_ENCRYPTION_KEY=
# Optional trusted receiver for rich events from every project. See docs/webhooks.md.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Optional Authorization value, sent verbatim. Add Bearer only if required.
WEBHOOK_AUTHORIZATION=
# Do not also set Authorization below when WEBHOOK_AUTHORIZATION is nonempty.
# Optional receiver auth: {"Authorization":"Bearer <sender-key>","X-Routine-Key":"<custom-key>"}
WEBHOOK_HEADERS=
RESEND_API_KEY=
EMAIL_FROM=feedback@nerdswhofish.com
FARO_COLLECTOR_URL=
# Production can use http://alloy.monitoring.svc:4318 without auth headers.
# Direct Grafana Cloud: https://otlp-gateway-prod-us-east-3.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Opt in for private IPs or service.namespace names; public HTTP stays blocked.
OTEL_EXPORTER_OTLP_INSECURE=false
